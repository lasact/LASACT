<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Credentialing Pathway</title>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --blue: #2278d5;
    --light-bg: #ecf0ef;
    --sky: #97c9ff;
    --navy: #152753;
    --font-head: 'Oswald', sans-serif;
    --font-body: 'Open Sans', sans-serif;
    --tab-h: 56px;
    --panel-max: 600px;
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
  }

  body {
    font-family: var(--font-body);
    background: #f0f4f8;
    min-height: 200vh;
    padding-bottom: 80px;
  }

  /* ── STICKY TAB WRAPPER ── */
  #cred-widget {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, var(--panel-max));
    z-index: 9999;
    font-family: var(--font-body);
  }

  /* ── TAB TRIGGER ── */
  #cred-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: var(--tab-h);
    background: var(--navy);
    color: #fff;
    cursor: pointer;
    border-radius: 14px 14px 0 0;
    padding: 0 24px;
    user-select: none;
    transition: background 0.2s var(--ease);
    box-shadow: 0 -4px 20px rgba(21,39,83,0.18);
  }
  #cred-tab:hover { background: #1e3a6e; }

  #tab-label {
    font-family: var(--font-head);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #tab-chevron {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    transition: transform 0.35s var(--ease);
  }
  .panel-open #tab-chevron { transform: rotate(180deg); }

  /* ── PANEL ── */
  #cred-panel {
    background: var(--light-bg);
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.45s var(--ease);
    border-top: 2px solid var(--blue);
  }
  .panel-open #cred-panel {
    max-height: 80vh;
    overflow-y: auto;
  }

  .panel-inner {
    padding: 20px 20px 28px;
  }

  /* ── SCREEN: CREDENTIAL PICKER ── */
  .screen { display: none; }
  .screen.active { display: block; }

  .screen-title {
    font-family: var(--font-head);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 14px;
  }

  .cred-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .cred-btn {
    background: #fff;
    border: 1.5px solid #d0dce8;
    border-radius: 10px;
    padding: 14px 12px;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .cred-btn:hover {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(34,120,213,0.12);
  }
  .cred-btn:active { transform: scale(0.97); }

  .cred-acronym {
    font-family: var(--font-head);
    font-size: 20px;
    font-weight: 600;
    color: var(--navy);
    line-height: 1;
    margin-bottom: 4px;
  }
  .cred-name {
    font-size: 11px;
    color: #5a6e8c;
    line-height: 1.35;
    font-weight: 500;
  }
  .cred-tag {
    display: inline-block;
    margin-top: 7px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--sky);
    color: var(--navy);
  }

  /* ── SCREEN: STEPS ── */
  .steps-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }

  .back-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--blue);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
    flex-shrink: 0;
  }
  .back-btn svg { width: 14px; height: 14px; }

  .steps-cred-badge {
    font-family: var(--font-head);
    font-size: 18px;
    font-weight: 600;
    color: var(--navy);
  }
  .steps-cred-full {
    font-size: 12px;
    color: #5a6e8c;
    font-weight: 500;
    margin-top: 1px;
  }

  /* Step list */
  .step-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .step-item {
    display: flex;
    gap: 14px;
    position: relative;
  }

  .step-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .step-dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    transition: transform 0.2s var(--ease);
  }

  .step-line {
    width: 2px;
    flex: 1;
    background: linear-gradient(to bottom, var(--sky), transparent);
    min-height: 20px;
    margin-top: 0;
  }

  .step-item:last-child .step-line { display: none; }

  .step-body {
    padding-bottom: 20px;
    flex: 1;
  }

  .step-title {
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    letter-spacing: 0.02em;
    line-height: 1.2;
    margin-top: 5px;
    margin-bottom: 5px;
  }

  .step-desc {
    font-size: 12.5px;
    color: #445566;
    line-height: 1.6;
  }

  .step-desc ul {
    list-style: none;
    margin-top: 4px;
  }
  .step-desc ul li {
    padding-left: 14px;
    position: relative;
    margin-bottom: 2px;
  }
  .step-desc ul li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sky);
    position: absolute;
    left: 0;
    top: 7px;
  }

  .step-highlight {
    display: inline-block;
    background: rgba(34,120,213,0.1);
    color: var(--blue);
    font-weight: 600;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
    margin-top: 5px;
  }

  /* Final step special */
  .step-item.final .step-dot {
    background: var(--navy);
    width: 32px;
    height: 32px;
    font-size: 16px;
  }

  /* Animate steps in */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .step-item {
    opacity: 0;
    animation: fadeUp 0.35s var(--ease) forwards;
  }
  .step-item:nth-child(1) { animation-delay: 0.05s; }
  .step-item:nth-child(2) { animation-delay: 0.12s; }
  .step-item:nth-child(3) { animation-delay: 0.19s; }
  .step-item:nth-child(4) { animation-delay: 0.26s; }
  .step-item:nth-child(5) { animation-delay: 0.33s; }
  .step-item:nth-child(6) { animation-delay: 0.40s; }
  .step-item:nth-child(7) { animation-delay: 0.47s; }
  .step-item:nth-child(8) { animation-delay: 0.54s; }

  /* Mobile tweaks */
  @media (max-width: 480px) {
    .cred-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .cred-acronym { font-size: 17px; }
    .cred-name { font-size: 10.5px; }
    .panel-inner { padding: 16px 14px 24px; }
    #tab-label { font-size: 13px; }
  }

  /* LASACT tip box */
  .lasact-tip {
    background: rgba(34,120,213,0.07);
    border-left: 3px solid var(--blue);
    border-radius: 0 6px 6px 0;
    padding: 8px 10px;
    margin-top: 8px;
    font-size: 11.5px;
    color: #2a4a70;
    line-height: 1.55;
  }
  .lasact-tip strong { color: var(--navy); }

  /* Scrollbar style */
  #cred-panel::-webkit-scrollbar { width: 4px; }
  #cred-panel::-webkit-scrollbar-track { background: transparent; }
  #cred-panel::-webkit-scrollbar-thumb { background: var(--sky); border-radius: 2px; }
</style>
</head>
