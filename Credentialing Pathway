const screenSteps = document.getElementById('screen-steps');

let isOpen = false;

tab.addEventListener('click', togglePanel);
tab.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); togglePanel(); } });

function togglePanel() {
  isOpen = !isOpen;
  widget.classList.toggle('panel-open', isOpen);
  tab.setAttribute('aria-expanded', isOpen);
  if (isOpen) panel.scrollTop = 0;
}

function showPicker() {
  screenPick.classList.add('active');
  screenSteps.classList.remove('active');
}

function showSteps(key) {
  const cred = CREDENTIALS[key];
  if (!cred) return;

  document.getElementById('steps-acronym').textContent = key;
  document.getElementById('steps-fullname').textContent = cred.name;

  const list = document.getElementById('step-list');
  list.innerHTML = '';

  cred.steps.forEach((step, i) => {
    const li = document.createElement('li');
    li.className = 'step-item' + (step.isFinal ? ' final' : '');

    let bulletsHtml = '';
    if (step.bullets && step.bullets.length) {
      bulletsHtml = '<ul>' + step.bullets.map(b => `<li>${b}</li>`).join('') + '</ul>';
    }

    const highlightHtml = step.highlight
      ? `<div class="step-highlight">${step.highlight}</div>`
      : '';

    const tipHtml = step.tip || '';

    li.innerHTML = `
      <div class="step-left">
        <div class="step-dot">${step.isFinal ? '✓' : i + 1}</div>
        <div class="step-line"></div>
      </div>
      <div class="step-body">
        <div class="step-title">${step.title}</div>
        <div class="step-desc">${step.desc}${bulletsHtml}${highlightHtml}${tipHtml}</div>
      </div>
    `;
    list.appendChild(li);
  });

  screenPick.classList.remove('active');
  screenSteps.classList.add('active');
  panel.scrollTop = 0;
}
</script>
</body>
</html>
