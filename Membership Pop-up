<!-- =====================================================
     LASACT Membership Reinstatement Popup
     Paste this block just before </body> on your membership page
     ===================================================== -->

<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">

<style>
  #lasact-overlay {
    position: fixed;
    inset: 0;
    background: rgba(21, 39, 83, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  #lasact-overlay.visible {
    opacity: 1;
    pointer-events: all;
  }
  #lasact-modal {
    background: #ebf7ff;
    border-radius: 14px;
    max-width: 500px;
    width: 90%;
    padding: 0;
    overflow: hidden;
    transform: translateY(28px) scale(0.97);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.5s ease;
    opacity: 0;
    box-shadow: 0 24px 60px rgba(21, 39, 83, 0.28);
  }
  #lasact-overlay.visible #lasact-modal {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  .lm-header {
    background: #152753;
    padding: 28px 32px 22px;
    position: relative;
  }
  .lm-badge {
    display: inline-block;
    background: #4b71dc;
    color: #ffffff;
    font-family: 'Open Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 20px;
    margin-bottom: 12px;
  }
  .lm-title {
    font-family: 'Palatino Linotype', 'Book Antiqua', Palatino, serif;
    color: #ebf7ff;
    font-size: 22px;
    font-weight: normal;
    line-height: 1.3;
    margin: 0;
  }
  .lm-close {
    position: absolute;
    top: 14px;
    right: 18px;
    background: rgba(235, 247, 255, 0.15);
    border: none;
    color: #ebf7ff;
    font-size: 20px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .lm-close:hover {
    background: rgba(235, 247, 255, 0.28);
  }
  .lm-body {
    padding: 26px 32px 28px;
  }
  .lm-divider {
    width: 48px;
    height: 3px;
    background: #4b71dc;
    border-radius: 2px;
    margin-bottom: 18px;
  }
  .lm-text {
    font-family: 'Open Sans', sans-serif;
    font-size: 15px;
    color: #152753;
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .lm-highlight {
    background: #ffffff;
    border-left: 4px solid #4b71dc;
    border-radius: 0 8px 8px 0;
    padding: 14px 18px;
    margin: 0 0 22px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .lm-highlight-icon {
    font-size: 22px;
    flex-shrink: 0;
  }
  .lm-highlight-text {
    font-family: 'Open Sans', sans-serif;
    font-size: 14px;
    color: #152753;
    line-height: 1.5;
  }
  .lm-highlight-text strong {
    display: block;
    color: #4b71dc;
    font-size: 20px;
    font-weight: 700;
  }
  .lm-cta {
    display: block;
    width: 100%;
    background: #152753;
    color: #ebf7ff;
    font-family: 'Open Sans', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-align: center;
    padding: 14px 20px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    letter-spacing: 0.3px;
    box-sizing: border-box;
  }
  .lm-cta:hover {
    background: #4b71dc;
    transform: translateY(-1px);
  }
  .lm-dismiss {
    display: block;
    text-align: center;
    margin-top: 12px;
    font-family: 'Open Sans', sans-serif;
    font-size: 13px;
    color: #152753;
    opacity: 0.55;
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
  }
  .lm-dismiss:hover {
    opacity: 0.85;
    text-decoration: underline;
  }
</style>

<div id="lasact-overlay">
  <div id="lasact-modal" role="dialog" aria-modal="true" aria-labelledby="lm-heading">

    <div class="lm-header">
      <button class="lm-close" onclick="closeLasactPopup()" aria-label="Close notice">&times;</button>
      <div class="lm-badge">Important Notice</div>
      <h2 class="lm-title" id="lm-heading">
        Individual Membership<br>Reinstatement Required
      </h2>
    </div>

    <div class="lm-body">
      <div class="lm-divider"></div>
      <p class="lm-text">
        Individual memberships that were <strong>not renewed by March 31, 2026</strong> have now
        lapsed and must be formally reinstated to restore full member benefits and access.
      </p>
      <div class="lm-highlight">
        <div class="lm-highlight-icon">&#128274;</div>
        <div class="lm-highlight-text">
          Reinstatement fee
          <strong>$120.00</strong>
        </div>
      </div>
      <a class="lm-cta"
         href="https://form.jotform.com/243025217306042"
         target="_blank"
         rel="noopener noreferrer">
        Reinstate My Membership &rarr;
      </a>
      <button class="lm-dismiss" onclick="closeLasactPopup()">I'll do this later</button>
    </div>

  </div>
</div>

<script>
  function closeLasactPopup() {
    var overlay = document.getElementById('lasact-overlay');
    var modal   = document.getElementById('lasact-modal');
    overlay.style.opacity      = '0';
    overlay.style.pointerEvents = 'none';
    modal.style.transform      = 'translateY(16px) scale(0.97)';
    modal.style.opacity        = '0';
  }

  // Show popup after 3 seconds
  setTimeout(function () {
    document.getElementById('lasact-overlay').classList.add('visible');
  }, 3000);

  // Close when clicking the dark backdrop
  document.getElementById('lasact-overlay').addEventListener('click', function (e) {
    if (e.target === this) closeLasactPopup();
  });
</script>

