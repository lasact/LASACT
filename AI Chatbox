ADRA — CREDENTIALING BODY (la-adra.org)
━━━━━━━━━━━━━━━━━━━━━━━━━
Full name: Addictive Disorder Regulatory Authority
Role: State licensing and credentialing board for addiction counselors and prevention professionals in Louisiana.
Address: 12041 Bricksome Avenue, Suite B, Baton Rouge, LA 70816
Phone: (225) 361-0698
Office hours: 7am–3pm | Phone hours: 8am–2pm, Tuesday–Friday (observes state holidays)
Applications & renewals: submitted through Certemy portal
Credential verification: app.certemy.com/public-registry/8ca73d3d-b51c-42b9-9e44-892b2411d264
Board meetings: 3rd Friday of January, April, July, October
Website: la-adra.org

━━━━━━━━━━━━━━━━━━━━━━━━━
OTHER PAGES
━━━━━━━━━━━━━━━━━━━━━━━━━
- Employment: lasact.org/employment
- Recovery Ready: lasact.org/recovery-ready
- Online Payments: lasact.org/online-payments
- Contact: lasact.org/contact

━━━━━━━━━━━━━━━━━━━━━━━━━
RULES
━━━━━━━━━━━━━━━━━━━━━━━━━
- Only answer based on information from lasact.org and la-adra.org
- Always link to the relevant page when discussing a topic
- Direct credentialing questions to ceb@lasact.org
- Direct membership questions to isabel@lasact.org
- Be warm, concise, and helpful
- If unsure, direct the user to lasact.org/contact`;

var C0 = ["Membership info","Credentialing & testing","Education & CEUs","Workshops","Annual conference","Contact LASACT"];

var msgs = [], busy = false, isOpen = false;

var launcher = document.getElementById('lsa-launcher');
var win      = document.getElementById('lsa-window');
var msgBox   = document.getElementById('lsa-msgs');
var chipsEl  = document.getElementById('lsa-chips');
var inp      = document.getElementById('lsa-input');
var sendBtn  = document.getElementById('lsa-send');

launcher.addEventListener('click', function(){
  isOpen = !isOpen;
  launcher.classList.toggle('open', isOpen);
  win.classList.toggle('open', isOpen);
  if(isOpen && msgs.length === 0) init();
  if(isOpen) setTimeout(function(){ inp.focus(); }, 320);
});

function init(){
  bot("Hello! I'm the LASACT virtual assistant. I can help you with membership, credentialing, education courses, workshops, and more. What can I help you with today?");
  showChips(C0);
}

function bot(t){ msgBox.appendChild(bubble('b', t)); scroll(); }
function user(t){ msgBox.appendChild(bubble('u', t)); scroll(); }

function bubble(role, t){
  var w = document.createElement('div');
  w.className = 'lsa-bbl ' + role;
  if(role === 'b'){
    var av = document.createElement('div');
    av.className = 'lsa-bbl-av';
    av.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>';
    w.appendChild(av);
  }
  var tx = document.createElement('div');
  tx.className = 'lsa-bbl-txt';
  tx.innerHTML = fmt(t);
  w.appendChild(tx);
  return w;
}

function fmt(s){
  return s
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/\[([^\]]+)\]\((https?:\/\/[^\)]+)\)/g, '<a href="$2" style="color:#1a3a5c;" target="_blank">$1</a>')
    .replace(/\n/g, '<br>');
}

function showTyping(){
  var w = document.createElement('div');
  w.className = 'lsa-bbl b'; w.id = 'lsa-typing';
  var av = document.createElement('div');
  av.className = 'lsa-bbl-av';
  av.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>';
  var tx = document.createElement('div');
  tx.className = 'lsa-bbl-txt';
  tx.innerHTML = '<div class="lsa-dots"><span></span><span></span><span></span></div>';
  w.appendChild(av); w.appendChild(tx);
  msgBox.appendChild(w); scroll();
}
function killTyping(){ var e = document.getElementById('lsa-typing'); if(e) e.remove(); }

function showChips(arr){
  chipsEl.innerHTML = '';
  arr.forEach(function(l){
    var b = document.createElement('button');
    b.className = 'lsa-chip'; b.textContent = l;
    b.onclick = function(){ chipsEl.innerHTML = ''; send(l); };
    chipsEl.appendChild(b);
  });
}

function scroll(){ msgBox.scrollTop = msgBox.scrollHeight; }

async function send(text){
  text = text.trim();
  if(!text || busy) return;
  busy = true;
  chipsEl.innerHTML = '';
  user(text);
  inp.value = ''; inp.style.height = 'auto';
  showTyping();
  msgs.push({role:'user', content: text});

  try{
    var res = await fetch(WORKER_URL, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        model: 'claude-sonnet-4-5',
        max_tokens: 600,
        system: SYS,
        messages: msgs
      })
    });
    var data = await res.json();
    var reply = (data.content && data.content[0] && data.content[0].text)
      ? data.content[0].text
      : "I'm having trouble right now. Please contact LASACT directly at [lasact.org/contact](https://www.lasact.org/contact).";
    msgs.push({role:'assistant', content: reply});
    killTyping(); bot(reply);

    var lo = text.toLowerCase();
    if(/member|join|renew|dues/.test(lo))
      showChips(["Individual membership","Org membership","Member benefits","Contact Isabel"]);
    else if(/credential|cit|lac|cac|rac|ccs|test|exam|adra/.test(lo))
      showChips(["Testing procedure","Exam fees","ADRA website","Contact Donna"]);
    else if(/education|ceu|course|train|lact|180|hour/.test(lo))
      showChips(["SUD training","Gambling training","Clinical supervision","Enroll now"]);
    else if(/workshop|seminar/.test(lo))
      showChips(["Workshop topics","Test prep workshop","CEUs offered","Schedule"]);
    else if(/conference|annual|event/.test(lo))
      showChips(["Conference info","Free with membership","CEU hours","Register"]);
    else if(/contact|email|phone|reach/.test(lo))
      showChips(["Membership contact","Credentialing contact","ADRA contact","Contact page"]);
    else if(/adra|regulatory|authority|state/.test(lo))
      showChips(["ADRA credentials","Apply to ADRA","ADRA contact","Credential verification"]);
    else if(/employ|job|hiring|career/.test(lo))
      showChips(["Job board","Post a job","Membership benefits","Contact LASACT"]);
    else
      showChips(["Membership info","Credentialing","Education & CEUs","Contact LASACT"]);

  } catch(e){
    killTyping();
    bot("I'm having trouble connecting. Please contact LASACT at [lasact.org/contact](https://www.lasact.org/contact).");
  }
  busy = false;
}

sendBtn.addEventListener('click', function(){ send(inp.value); });
inp.addEventListener('keydown', function(e){
  if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); send(inp.value); }
});
inp.addEventListener('input', function(){
  this.style.height = 'auto';
  this.style.height = Math.min(this.scrollHeight, 110) + 'px';
});
})();
</script>
